{
  "templateVersion": 1,
  "id": "ssd",
  "name": "春天",
  "domain": "https://springsunday.net",
  "schema": "NexusPHP",
  "encoding": "UTF-8",
  "meta": {
    "has_hr": true
  },
  "requests": {
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "",
      "fields": {
        "is_login": {
          "any": [
            {
              "selector": "//a[contains(@href, 'logout')]/text()"
            },
            {
              "selector": "//a[contains(@data-url, 'logout')]/text()"
            },
            {
              "selector": "//a[contains(@href, 'mybonus')]/text()"
            },
            {
              "selector": "//a[contains(@onclick, 'logout')]/text()"
            },
            {
              "selector": "//a[contains(@href, 'usercp')]/text()"
            },
            {
              "selector": "//form[contains(@action, 'logout')]/text()"
            },
            {
              "selector": "//div[@class='user-info-side']/text()"
            }
          ],
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "userdetails.php\\?id=(\\d+)",
                1
              ]
            }
          ]
        },
        "name": {
          "any": [
            {
              "selector": "//a[contains(@href, 'userdetails')]//b//text()"
            },
            {
              "selector": "//a[contains(@href, 'userdetails')]//text()"
            },
            {
              "selector": "//a[contains(@href, 'userdetails')]//strong//text()"
            }
          ]
        },
        "uploaded": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "[^总]上[传傳]量?[:：_<>/a-zA-Z-=''\\s#;]+([\\d,.\\s]+(?i)[KMGTPI]*B)",
                1
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "[^总子影力]下[载載]量?[:：_<>/a-zA-Z-=''\\s#;]+([\\d,.\\s]+(?i)[KMGTPI]*B)",
                1
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "ratio": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "replace",
              "args": [
                "无限",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "无穷",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "∞",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "Infinity",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "infinity",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "Inf",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "inf",
                ""
              ]
            },
            {
              "name": "re_search",
              "args": [
                "分享率[:：_<>/a-zA-Z-=\\\"'\\s#;]+([\\d,.\\s]+)",
                1
              ]
            }
          ]
        },
        "bonus": {
          "selector": "//a[contains(@href,'mybonus')]/@title",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "([\\d,.]+)",
                1
              ]
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "XPath",
      "method": "GET",
      "path": "/userdetails.php?id={userId}",
      "fields": {
        "level": {
          "any": [
            {
              "selector": "//tr/td[contains(text(), '等級') or contains(text(), '等级')]/following-sibling::td[1]/img[1]/@title"
            },
            {
              "selector": "//tr/td[contains(text(), '等級') or contains(text(), '等级')]/following-sibling::td[1 and not(img)]|//tr/td[contains(text(), '等級') or contains(text(), '等级')]/following-sibling::td[1 and img[not(@title)]]"
            },
            {
              "selector": "//tr/td[contains(text(), '等級') or contains(text(), '等级')]/following-sibling::td[1]"
            },
            {
              "selector": "//a[contains(@href, 'userdetails')]/text()",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "\\[(.*)]",
                    1
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "search": {
      "parser": "CssSelector",
      "method": "GET",
      "path": "/torrents.php",
      "params": {
        "search": [
          "{keyword}"
        ]
      },
      "list": {
        "selector": "table.torrents tr:has(table.torrentname)",
        "container": "table.torrents",
        "next_page": {
          "selector": "a[rel='next'][href], a[href]:contains('下一页'), a[href]:contains('下一頁'), a[href]:contains('Next'), a[href]:contains('next')",
          "attribute": "href"
        }
      },
      "fields": {
        "id": {
          "selector": "a[href*='details.php?id=']",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "\\d+",
                0
              ]
            }
          ]
        },
        "title": {
          "any": [
            {
              "selector": "a[title][href*='details.php?id=']",
              "attribute": "title"
            },
            {
              "selector": "a[href*='details.php?id=']"
            }
          ]
        },
        "details": {
          "selector": "a[href*='details.php?id=']",
          "attribute": "href"
        },
        "download": {
          "selector": "a[href*='download.php?id=']",
          "attribute": "href"
        },
        "size": {
          "selector": "td:nth-child(5):not(.embedded)",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "seeders": {
          "selector": "td:nth-child(6):not(.embedded)"
        },
        "leechers": {
          "selector": "td:nth-child(7):not(.embedded)"
        },
        "downloadvolumefactor": {
          "any": [
            {
              "selector": "span.torrent-pro-icon.torrent-pro-free,span.torrent-pro-icon.torrent-pro-twoupfree",
              "attribute": "class",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    0,
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "span.torrent-pro-icon.torrent-pro-halfdown,span.torrent-pro-icon.torrent-pro-twouphalfdown",
              "attribute": "class",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    0.5,
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "span.torrent-pro-icon.torrent-pro-thirtypercent",
              "attribute": "class",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    0.3,
                    ""
                  ]
                }
              ]
            }
          ]
        },
        "description": {
          "selector": "td.embedded > div.torrent-smalldescr > span",
          "remove": "span,a,img,font,b",
          "filters": [
            {
              "name": "split",
              "args": [
                "\n",
                -1
              ]
            }
          ]
        },
        "labels": {
          "selector": "td.embedded > div.torrent-smalldescr > a > span",
          "array": true
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/getusertorrentlistajax.php?userid={userId}&type=seeding",
      "fields": {
        "count": {
          "selector": "(.//b)[1]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "re_search",
              "args": [
                "^\\d+$",
                0
              ]
            }
          ]
        },
        "size": {
          "selector": "(.//b)[2]",
          "filters": [
            {
              "name": "strip"
            },
            {
              "name": "re_search",
              "args": [
                "(?i)^[0-9][0-9,.]*\\s*[KMGTPE]?i?B$",
                0
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        }
      },
      "headers": {
        "Referer": "{domain}/userdetails.php?id={userId}"
      },
      "summary": {
        "selector": "//body[count(.//b)=2]"
      }
    }
  }
}
