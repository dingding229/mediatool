        "1.1.2": "Declare minimal per-route Host execution scopes",
        "1.2.0": "Chain/module hooks, DownloadAdded, JSON forms, multi dashboards and bundled ESM",
        "1.3.0": "Manual F3 read-only host acceptance and denied-scope check",
        "1.4.0": "Typed acquisition facts and no-op resource policy chains (F4-A)",
        "1.5.0": "Typed organizing facts and no-op safe transfer/storage policies (F4-B)",
        "1.6.0": "Typed metadata/coverage and cached source no-op policies (F4-C)",
        "1.7.0": "F4-D typed system/notification/settings/Telegram facts; pre-effect module declines and /hello ingress example",
        "1.7.1": "Two-phase pure offer/execute module protocol; only pre-execute declines can fall back",
        "1.8.0": "F4 bounded workflow and opt-in fake auth broker contracts; no real login provider",
        "1.8.1": "Declare hello action Host scopes; opt-in no-secret action ceiling probe"
