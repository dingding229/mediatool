{
  "id": "ttg",
  "name": "听听歌（精简模板）",
  "domain": "https://totheglory.im",
  "schema": "ttg",
  "encoding": "UTF-8",
  "meta": {
    "has_hr": true
  },
  "requests": {
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "",
      "fields": {
        "is_login": {
          "any": [
            {
              "selector": "//a[contains(@href, 'logout')]/text()"
            },
            {
              "selector": "//a[contains(@data-url, 'logout')]/text()"
            },
            {
              "selector": "//a[contains(@href, 'mybonus')]/text()"
            },
            {
              "selector": "//a[contains(@onclick, 'logout')]/text()"
            },
            {
              "selector": "//a[contains(@href, 'usercp')]/text()"
            },
            {
              "selector": "//form[contains(@action, 'logout')]/text()"
            },
            {
              "selector": "//div[@class='user-info-side']/text()"
            }
          ],
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "userdetails.php\\?id=(\\d+)",
                1
              ]
            }
          ]
        },
        "name": {
          "any": [
            {
              "selector": "//a[contains(@href, 'userdetails')]//b//text()"
            },
            {
              "selector": "//a[contains(@href, 'userdetails')]//text()"
            },
            {
              "selector": "//a[contains(@href, 'userdetails')]//strong//text()"
            }
          ]
        },
        "uploaded": {
          "selector": "//font[contains(text(), '上传量')]/following-sibling::font[1]/a/text()",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "//font[contains(text(), '下载量')]/following-sibling::font[1]/a/text()",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "ratio": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "replace",
              "args": [
                "无限",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "无穷",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "∞",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "Infinity",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "infinity",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "Inf",
                ""
              ]
            },
            {
              "name": "replace",
              "args": [
                "inf",
                ""
              ]
            },
            {
              "name": "re_search",
              "args": [
                "分享率[:：_<>/a-zA-Z-=\\\"'\\s#;]+([\\d,.\\s]+)",
                1
              ]
            }
          ]
        },
        "bonus": {
          "any": [
            {
              "selector": "//a[contains(@href,'mybonus') or contains(@href,'bonus.php')]/text()",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "([\\d,.]+)",
                    1
                  ]
                }
              ]
            },
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "mybonus.[\\[\\]:：<>/a-zA-Z_\\-=''\\s#;.(使用魔力值豆]+\\s*([\\d,.]+)[<()&\\s\\[]",
                    1
                  ]
                }
              ]
            },
            {
              "selector": "*",
              "selection": "html",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "[魔力值|\\]][\\[\\]:：<>/a-zA-Z_\\-=''\\s#;]+\\s*([\\d,.]+|\\'[\\d,.]+')[<>()&\\s\\[]",
                    1
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "XPath",
      "method": "GET",
      "path": "/userdetails.php?id={userId}",
      "fields": {
        "level": {
          "any": [
            {
              "selector": "//tr/td[contains(text(), '等級') or contains(text(), '等级')]/following-sibling::td[1]/img[1]/@title"
            },
            {
              "selector": "//tr/td[contains(text(), '等級') or contains(text(), '等级')]/following-sibling::td[1 and not(img)]|//tr/td[contains(text(), '等級') or contains(text(), '等级')]/following-sibling::td[1 and img[not(@title)]]"
            },
            {
              "selector": "//tr/td[contains(text(), '等級') or contains(text(), '等级')]/following-sibling::td[1]"
            },
            {
              "selector": "//a[contains(@href, 'userdetails')]/text()",
              "filters": [
                {
                  "name": "re_search",
                  "args": [
                    "\\[(.*)]",
                    1
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "search": {
      "parser": "CssSelector",
      "method": "GET",
      "path": "/browse.php",
      "params": {
        "c": [
          "M"
        ],
        "search_field": [
          "{keyword}"
        ]
      },
      "list": {
        "selector": "table#torrent_table tr[id]",
        "container": "table#torrent_table",
        "next_page": {
          "selector": "a[rel='next'][href], a[href]:contains('下一页'), a[href]:contains('下一頁'), a[href]:contains('Next'), a[href]:contains('next')",
          "attribute": "href"
        }
      },
      "fields": {
        "id": {
          "selector": "div.name_left > a",
          "attribute": "href",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "\\d+",
                0
              ]
            }
          ]
        },
        "title": {
          "selector": "div.name_left > a > b",
          "remove": "span",
          "filters": [
            {
              "name": "split",
              "args": [
                "\n",
                0
              ]
            }
          ]
        },
        "details": {
          "selector": "div.name_left > a",
          "attribute": "href"
        },
        "download": {
          "selector": "a.dl_a",
          "attribute": "href"
        },
        "size": {
          "selector": "td:nth-child(7)",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "seeders": {
          "selector": "td:nth-child(9) > b > a >font"
        },
        "leechers": {
          "selector": "td:nth-child(9) > b:nth-child(2) > a"
        },
        "downloadvolumefactor": {
          "any": [
            {
              "selector": "img[alt='free']",
              "attribute": "alt",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    0,
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "img[alt='50%']",
              "attribute": "alt",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    0.5,
                    ""
                  ]
                }
              ]
            },
            {
              "selector": "img[alt='30%']",
              "attribute": "alt",
              "filters": [
                {
                  "name": "not_blank",
                  "args": [
                    0.3,
                    ""
                  ]
                }
              ]
            }
          ]
        },
        "description": {
          "remove": "span,a,img,font,b",
          "filters": [
            {
              "name": "split",
              "args": [
                "\n",
                -1
              ]
            }
          ],
          "any": [
            {
              "selector": "div.name_left > a > b > font > span"
            },
            {
              "selector": "div.name_left > a > b > span"
            }
          ]
        },
        "labels": {
          "selector": "div.name_left > span > b",
          "array": true
        },
        "hr_days": {
          "selector": "td:nth-child(2) > div.name_left > img:nth-child(6)",
          "attribute": "title",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "(?i)(?:\\bH\\s*&?\\s*R\\b|\\bhit[ -]*and[ -]*run\\b|保种|做种|考核)[^\\d]{0,80}(\\d+)",
                1
              ]
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "parser": "XPath",
      "method": "GET",
      "path": "/userdetails.php?id={userId}",
      "headers": {
        "Referer": "{domain}/userdetails.php?id={userId}"
      },
      "list": {
        "selector": "//td[contains(text(), '当前上传')]/following-sibling::td//table//tr[position()>1]",
        "next_page": {
          "selector": "//a[contains(text(), '下一页') or contains(text(), '下一頁')]/@href"
        }
      },
      "fields": {
        "size": {
          "selector": "/td[4]",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        }
      }
    }
  }
}
