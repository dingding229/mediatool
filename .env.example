# Generate real keys with python3 scripts/init-env.py. Do not commit .env.
APP_ENV=development
APP_ADDR=127.0.0.1:8080
APP_PUBLIC_URL=http://localhost:8080
# Vue HMR: make dev overrides APP_PUBLIC_URL to http://localhost:5173
# Optional dedicated server-side session signing key; never used as a login password.
SESSION_SECRET_KEY=
STRM_API_KEY=
POSTGRES_USER=media_tool
POSTGRES_DB=media_tool
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Database is required for registration, login and administrator sessions. Compose supplies internal URLs.
DATABASE_URL=
REDIS_URL=
STRM_ALLOWED_ROOTS=/115/Media
STRM_OUTPUT_DIR=./data/strm
CLOUDDRIVE_ENDPOINT=
CLOUDDRIVE_TOKEN=
EMBY_UPSTREAM_URL=
EMBY_PROXY_ENABLED=false
WORKER_POLL_INTERVAL=2s
WORKER_LEASE=90s


# M0 CloudDrive2 native gRPC. Prefer a restricted API token; http is private-LAN only.
CLOUDDRIVE_USERNAME=
CLOUDDRIVE_PASSWORD=
CLOUDDRIVE_CA_FILE=
CLOUDDRIVE_REQUEST_TIMEOUT=10s
CLOUDDRIVE_MAX_LIST_FILES=1000
# Special UA/headers use controlled streaming; force proxy for IP-bound links.
STRM_PROXY_FALLBACK=false
STRM_FORCE_PROXY=false
PLAYBACK_RESOLVE_TIMEOUT=30s
PLAYBACK_ALLOW_HTTP=false
PLAYBACK_ALLOWED_HOSTS=
# Minimal opt-in static Emby stream interception, not full web URL rewriting.
EMBY_302_ENABLED=false
EMBY_STRM_PATH_PREFIX=
EMBY_STRM_RESOLVER_ORIGINS=
# Optional real-environment verification inputs; never shown in diagnostics.
M0_MEDIA_PATH=
M0_EMBY_ITEM_ID=
M0_EMBY_MEDIA_SOURCE_ID=
M0_EMBY_USER_TOKEN=

# 32-byte hexadecimal credential encryption key; keep separate from DB backups.
APP_SECRET_KEY=

# Optional runtime UID/GID for existing host bind directories.
APP_UID=65532
APP_GID=65532

# Dedicated Emby listener. Blank disables it; management stays on APP_ADDR.
EMBY_GATEWAY_ADDR=127.0.0.1:8091
# Disable only after migrating legacy path/global-Key STRM links.
STRM_LEGACY_KEY_ENABLED=true

# Fixed public gateway origin behind HTTPS proxy; never trust client forwarded headers.
EMBY_PUBLIC_URL=

# true = refuse HLS/transcoding/remux/media relay; native codec support required.
EMBY_DIRECT_PLAY_ONLY=true

# Single-compose deployment / Docker Hub (AMD64)
COMPOSE_PROJECT_NAME=media-tool
APP_IMAGE=dingding229/mediatool:latest
APP_BIND=127.0.0.1
APP_PORT=8080
EMBY_GATEWAY_PORT=8091
LOG_LEVEL=info
POSTGRES_PORT=15432
REDIS_PORT=16379
# Optional existing database/cache volume names for migration; NEVER recreate data.
POSTGRES_VOLUME_NAME=media-tool_postgres-data
REDIS_VOLUME_NAME=media-tool_redis-data
# Absolute bind paths or named volumes. Empty uses named-volume defaults.
STRM_MOUNT=
DOWNLOADS_MOUNT=
LOCAL_FILES_MOUNT=

# Per-plugin worker tree task budget (process leaders included), 32..4096.
PLUGIN_MAX_TASKS=256
